# Copy to .env for local runs. Never commit .env.
DATABASE_URL=postgresql://queue:queue@localhost:5432/queue
# If set, POST endpoints require the header X-API-Key: <value>. Set this on any public deployment.
API_KEY=
# true = API process also runs worker threads (single-service deploys). false = run `python -m app.worker` separately.
EMBEDDED_WORKERS=true
WORKER_THREADS=4
LEASE_SECONDS=300
